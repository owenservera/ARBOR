{
  "version": 2,
  "functions": {
    "api/relay.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/mobile",
      "destination": "/index.html"
    },
    {
      "source": "/pair",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}

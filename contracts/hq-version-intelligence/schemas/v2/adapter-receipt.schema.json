{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arbor.local/hvi/v2/adapter-receipt.schema.json",
  "title": "Dual-digest provenance receipt",
  "type": "object",
  "properties": {
    "schema": {
      "const": "arbor.hvi.adapter.source-manifest/1"
    },
    "aDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cProjectionDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "pinId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repoIdentity": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+/[a-z0-9_.-]+$"
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "rootTreeSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "transformVersion": {
      "const": "arbor.hvi.adapter.source-manifest/1"
    },
    "policyOmissions": {
      "type": "integer",
      "minimum": 0
    },
    "observedEntries": {
      "type": "integer",
      "minimum": 0
    },
    "projectedEntries": {
      "type": "integer",
      "minimum": 0
    },
    "completeness": {
      "enum": [
        "complete",
        "partial",
        "blocked",
        "missing"
      ]
    },
    "truncated": {
      "type": "boolean"
    },
    "losses": {
      "type": "array",
      "maxItems": 0
    }
  },
  "required": [
    "schema",
    "aDigest",
    "cProjectionDigest",
    "pinId",
    "repoIdentity",
    "commitSha",
    "rootTreeSha",
    "transformVersion",
    "policyOmissions",
    "observedEntries",
    "projectedEntries",
    "completeness",
    "truncated",
    "losses"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.arbor.local/hvi/v1/migration-finding.schema.json",
  "title": "ARBOR HVI migration-finding v1",
  "description": "Source-only normative wire contract; no runtime authority inferred.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "origin_repo",
    "origin_sha",
    "origin_path",
    "origin_blob",
    "target_repo",
    "target_sha",
    "target_path",
    "target_blob",
    "identity_basis",
    "source_lineage",
    "capability_id",
    "source_type",
    "tests",
    "runtime_evidence",
    "decision",
    "certainty",
    "missing_reason",
    "owner",
    "merge_recommendation",
    "evidence_refs",
    "coverage"
  ],
  "properties": {
    "schema": {
      "const": "arbor.hvi.migration-finding/1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "origin_repo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "origin_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "origin_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "origin_blob": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "target_repo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "target_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "target_path": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "target_blob": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}$"
      }
    },
    "identity_basis": {
      "enum": [
        "exact_blob",
        "same_path",
        "explicit_owner",
        "symbol",
        "candidate",
        "unobservable"
      ]
    },
    "source_lineage": {
      "enum": [
        "source_present",
        "imported",
        "patched",
        "relocated",
        "split_candidate",
        "combine_candidate",
        "missing_at_path",
        "unobservable"
      ]
    },
    "capability_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_type": {
      "enum": [
        "executable",
        "test",
        "design",
        "research",
        "fixture",
        "generated",
        "unknown"
      ]
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "runtime_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "decision": {
      "enum": [
        "REVIEW_REQUIRED",
        "KEEP",
        "PORT_CANDIDATE",
        "INTENTIONALLY_EXCLUDED",
        "UNKNOWN",
        "BLOCKED"
      ]
    },
    "certainty": {
      "enum": [
        "confirmed",
        "candidate",
        "unknown"
      ]
    },
    "missing_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "merge_recommendation": {
      "enum": [
        "NONE",
        "REVIEW",
        "ADAPT",
        "PORT",
        "DO_NOT_PORT"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completeness",
        "observed",
        "expected",
        "truncated"
      ],
      "properties": {
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "blocked",
            "missing"
          ]
        },
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "expected": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    }
  }
}

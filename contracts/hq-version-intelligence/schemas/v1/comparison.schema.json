{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.arbor.local/hvi/v1/comparison.schema.json",
  "title": "ARBOR HVI comparison v1",
  "description": "Source-only normative wire contract; no runtime authority inferred.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "targetPinId",
    "sourcePins",
    "coverage",
    "summary",
    "sourceDeltas",
    "capabilityDeltas",
    "identityCandidates",
    "authorityConflicts",
    "unported",
    "intentionallyExcluded",
    "unobserved",
    "runtimeProof",
    "mergePlan",
    "evidenceIndex",
    "limits",
    "errors",
    "reproducibilityDigest",
    "owner"
  ],
  "properties": {
    "schema": {
      "const": "arbor.hvi.comparison/1"
    },
    "targetPinId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "sourcePins": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completeness",
        "observed",
        "expected",
        "truncated"
      ],
      "properties": {
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "blocked",
            "missing"
          ]
        },
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "expected": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "source",
        "capability",
        "runtime"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "SOURCE_PARITY",
            "INCOMPLETE"
          ]
        },
        "capability": {
          "enum": [
            "SEMANTIC_PARITY",
            "UNVERIFIED",
            "INCOMPLETE"
          ]
        },
        "runtime": {
          "enum": [
            "RUNTIME_PARITY",
            "UNVERIFIED"
          ]
        }
      }
    },
    "sourceDeltas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "pinId",
          "status",
          "evidenceRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "pinId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "status": {
            "enum": [
              "EXACT_BLOB",
              "SAME_PATH_CHANGED",
              "EXACT_RELOCATION",
              "SPLIT_CANDIDATE",
              "COMBINE_CANDIDATE",
              "SIMILARITY_CANDIDATE",
              "MISSING_AT_TARGET",
              "NEW_AT_TARGET",
              "UNOBSERVABLE"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          }
        },
        "additionalProperties": false
      }
    },
    "capabilityDeltas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "owner",
          "evidenceRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "status": {
            "enum": [
              "PRESENT_EQUIVALENT_CONFIRMED",
              "PRESENT_CHANGED",
              "IMPORTED_NOT_WIRED",
              "SOURCE_WIRED_UNVERIFIED",
              "RUNTIME_VERIFIED",
              "DESIGN_ONLY",
              "RESEARCH_IMPLEMENTED",
              "INTENTIONALLY_EXCLUDED",
              "BLOCKED",
              "UNKNOWN"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          }
        },
        "additionalProperties": false
      }
    },
    "identityCandidates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "authorityConflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "unported": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "intentionallyExcluded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "unobserved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "runtimeProof": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "mergePlan": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "evidenceIndex": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "maxPins",
        "maxEntries",
        "maxBlobBytes",
        "truncated"
      ],
      "properties": {
        "maxPins": {
          "type": "integer",
          "minimum": 2
        },
        "maxEntries": {
          "type": "integer",
          "minimum": 1
        },
        "maxBlobBytes": {
          "type": "integer",
          "minimum": 1
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "reproducibilityDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "pairwise": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.arbor.local/hvi/v1/identity-crosswalk.schema.json",
  "title": "ARBOR HVI identity-crosswalk v1",
  "description": "Source-only normative wire contract; no runtime authority inferred.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pinIds",
    "candidates",
    "authorityConflicts",
    "coverage",
    "owner"
  ],
  "properties": {
    "schema": {
      "const": "arbor.hvi.identity-crosswalk/1"
    },
    "pinIds": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "left",
          "right",
          "identityBasis",
          "disposition",
          "certainty",
          "owner",
          "evidenceRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "left": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "right": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "identityBasis": {
            "enum": [
              "source_id",
              "exact_blob",
              "canonical_declared",
              "explicit_owner_decision",
              "symbol_signature",
              "similarity_candidate"
            ]
          },
          "disposition": {
            "enum": [
              "REVIEW_REQUIRED",
              "CONFIRMED_EQUIVALENT",
              "KEEP_SEPARATE",
              "REJECTED"
            ]
          },
          "certainty": {
            "enum": [
              "confirmed",
              "candidate",
              "unknown"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "ownerConfirmed": {
            "type": "boolean"
          },
          "ownerReceiptRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "additionalProperties": false
      }
    },
    "authorityConflicts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completeness",
        "observed",
        "expected",
        "truncated"
      ],
      "properties": {
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "blocked",
            "missing"
          ]
        },
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "expected": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.arbor.local/hvi/v1/host-read-result.schema.json",
  "title": "ARBOR HVI host-read-result v1",
  "description": "Source-only normative wire contract; no runtime authority inferred.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "status",
    "scope",
    "actorId",
    "sessionId",
    "grantRef",
    "evaluatedAt",
    "owner",
    "coverage",
    "receipts"
  ],
  "properties": {
    "schema": {
      "const": "arbor.hvi.host-read-result/1"
    },
    "operation": {
      "const": "development.source.compare.read"
    },
    "status": {
      "enum": [
        "ok",
        "denied",
        "incomplete"
      ]
    },
    "scope": {
      "const": "development"
    },
    "actorId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "grantRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "owner": {
      "const": "Host"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completeness",
        "observed",
        "expected",
        "truncated"
      ],
      "properties": {
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "blocked",
            "missing"
          ]
        },
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "expected": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "resultDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "errorCode": {
      "enum": [
        "PIN_NOT_FOUND",
        "SOURCE_UNAUTHORIZED",
        "PIN_MOVED",
        "SCOPE_ESCAPE",
        "INCOMPLETE_SCAN",
        "DIGEST_CONFLICT",
        "ID_CONFLICT",
        "EQUIVALENCE_UNPROVEN",
        "RESOURCE_LIMIT"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "resultDigest"
        ],
        "properties": {
          "receipts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}

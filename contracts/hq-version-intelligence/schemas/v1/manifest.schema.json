{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.arbor.local/hvi/v1/manifest.schema.json",
  "title": "ARBOR HVI manifest v1",
  "description": "Source-only normative wire contract; no runtime authority inferred.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pinId",
    "commitSha",
    "digest",
    "entries",
    "coverage",
    "owner"
  ],
  "properties": {
    "schema": {
      "const": "arbor.hvi.manifest/1"
    },
    "pinId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entries": {
      "type": "array",
      "maxItems": 1000000,
      "items": {
        "type": "object",
        "required": [
          "path",
          "mode",
          "blobSha",
          "kind",
          "parseStatus"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f]+$"
          },
          "mode": {
            "enum": [
              "100644",
              "100755",
              "120000",
              "160000",
              "040000"
            ]
          },
          "blobSha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "file",
              "symlink",
              "submodule",
              "tree",
              "lfs_pointer",
              "binary",
              "unobservable"
            ]
          },
          "parseStatus": {
            "enum": [
              "parsed",
              "not_parsed",
              "blocked",
              "truncated",
              "unsupported"
            ]
          },
          "symlinkTarget": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "excludedReason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completeness",
        "observed",
        "expected",
        "truncated"
      ],
      "properties": {
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "blocked",
            "missing"
          ]
        },
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "expected": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  }
}

  "distinction": "Existing Rust types are in-process, neither JSON ABI nor runtime source/auth proof. Proposed fields below are DESIGNED, not implemented.",
  "mapping": [
    {
      "from": "hqkg::engine::EngineDescriptor{slot,implementation,interface,capabilities}",
      "to": "manifest.capabilityId, engine.slotId, engine.implementationDigest, interface.abiVersion, interface.inputSchemaRef/outputSchemaRef",
      "retained": [
        "slot",
        "interface",
        "capabilities"
      ],
      "missing": [
        "trust anchor for implementationDigest",
        "typed schemas",
        "semver/ABI negotiation",
        "source code review admission"
      ],
      "warning": "implementation is a free-form String; no cryptographic binding; interface merely equality checked on replacement"
    },
    {
      "from": "hqkg::engine::EngineRequest{operation,data:String}",
      "to": "CapabilityInvocation{capabilityId,slot,generation,operation,inputSchemaRef,typedPayload,actorBoundReadContext,deadlines}",
      "missing": [
        "serializable typed payload",
        "bounded input bytes",
        "owner-authenticated source scope",
        "deadline/token cancellation inheritance",
        "no raw actor trust"
      ],
      "warning": "EngineRequest accepts arbitrary String; no effect classification"
    },
    {
      "from": "hqkg::engine::EngineOutput{data:String}",
      "to": "DerivedEvidence{producer,revision,contentRefOrRedactedPayload,confidence,state,effectPerformed:false}",
      "missing": [
        "typed output bytes/schema",
        "classification/redaction",
        "audience/source-policy fence",
        "result size before allocation"
      ],
      "warning": "No Host receipt can be inferred from EngineOutput"
    },
    {
      "from": "hqkg::engine::SwapReceipt{slot,previous,generation}",
      "to": "ActivationDecision{manifestDigest,expectedRegistryRevision,admissionReceiptRef,decision,engineGeneration}",
      "missing": [
        "manifest/source attestation",
        "review receipt",
        "owner admission",
        "rollback/revocation identity",
        "serialization"
      ],
      "warning": "SwapReceipt proves registry mutation only, not owner approval or effect"
    },
    {
      "from": "hqkg::typed_dag::Namespace{domain,owner}",
      "to": "F SourceRef{domain,ownerRef} + N0 session actor/audience",
      "missing": [
        "authenticated actor principal",
        "separation of development/personal/control/ui domains",
        "explicit trusted source read"
      ],
      "warning": "A GraphDomain has only Development/Personal; F/N0 use four domains; do not cast them blindly"
    },
    {
      "from": "hqkg::typed_dag::RevisionToken{namespace,graph_epoch}",
      "to": "N0 {inputRevision,graphEpoch,policyVersion,engineVersion} + F RevisionEvent + Host policy/World version",
      "missing": [
        "sourceEpoch",
        "World/policy/catalog/pack revisions",
        "actor/session input sequence"
      ],
      "warning": "Revision equality local only; no source revocation check"
    },
    {
      "from": "hqkg::typed_dag::SourceBinding{id,revision,digest,provenance}",
      "to": "manifest.source{repo,commit,path,contentSha256,ownerDomain} + F EvidenceRef",
      "missing": [
        "trusted walker attestation",
        "read permit",
        "revocation epoch",
        "source class",
        "user data redaction"
      ],
      "warning": "Digest and provenance supplied by caller; not checked against actual bytes"
    },
    {
      "from": "vivim_programmability_core::Program/ValidatedProgram",
      "to": "manifest.mode + inert owner-admitted DAG declaration",
      "missing": [
        "manifest wire type",
        "source manifest verification",
        "capability owner registry binding"
      ],
      "warning": "validated.execution_authorized=false even with allow_effect_candidates=true"
    },
    {
      "from": "F contracts/interop/v1 {SourceRef,InertViewProjection}",
      "to": "capability event trace/projection",
      "missing": [
        "generation,manifestDigest,actor-verified context",
        "status precision: skipped stale, budget, revoked"
      ],
      "warning": "Type mirrors/JS display guard not admission"
    },
    {
      "from": "N0 IO-CONTRACT + Labs event fabric",
      "to": "FanOutInputSnapshot -> independent bounded pure DerivedEvidence[] -> revision/source/policy gate -> E inert projection",
      "missing": [
        "actual runtime producer registry/quota",
        "concurrent fanout",
        "ingress binding",
        "source-epoch rejection"
      ],
      "warning": "Do not create a new dispatcher, scheduler, graph, journal or plugin VM"
    }
  ],
  "plannedABI": {
    "name": "arbor.native-pure-capability/0-candidate",
